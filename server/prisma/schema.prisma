generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  WALLET
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  goals          Goal[]
  recurringRules RecurringRule[]
  tags           Tag[]
}

model Category {
  id             String              @id @default(cuid())
  userId         String
  type           TransactionType
  name           String
  color          String              @default("#64748b")
  isDefault      Boolean             @default(false)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]

  @@unique([id, userId])
  @@unique([userId, type, name])
  @@index([userId, type])
}

model Transaction {
  id              String              @id @default(cuid())
  userId          String
  categoryId      String
  recurringRuleId String?
  type            TransactionType
  amountMinor     Int
  currency        String              @default("AED")
  subCategory     String?
  date            DateTime
  paymentMethod   PaymentMethod
  description     String?
  receiptPath     String?
  occurrenceDate  DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category            @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)
  recurringRule   RecurringRule?      @relation(fields: [recurringRuleId, userId], references: [id, userId], onDelete: Restrict)
  tags            TransactionTag[]

  @@unique([id, userId])
  @@unique([recurringRuleId, occurrenceDate])
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([userId, categoryId, date])
}

model Tag {
  id           String            @id @default(cuid())
  userId       String
  name         String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([id, userId])
  @@unique([userId, name])
}

model TransactionTag {
  transactionId String
  tagId         String
  userId        String
  transaction   Transaction @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId, userId], references: [id, userId], onDelete: Cascade)

  @@id([transactionId, tagId])
}

model RecurringRule {
  id             String              @id @default(cuid())
  userId         String
  categoryId     String
  type           TransactionType
  amountMinor    Int
  currency       String              @default("AED")
  subCategory    String?
  paymentMethod  PaymentMethod
  description    String?
  frequency      RecurrenceFrequency
  startsAt       DateTime
  nextRunAt      DateTime
  endsAt         DateTime?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category            @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)
  transactions   Transaction[]

  @@unique([id, userId])
  @@index([isActive, nextRunAt])
}

model Budget {
  id          String    @id @default(cuid())
  userId      String
  categoryId  String?
  year        Int
  month       Int
  amountMinor Int
  currency    String    @default("AED")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, year, month])
}

model Goal {
  id            String             @id @default(cuid())
  userId        String
  name          String
  targetMinor   Int
  currency      String             @default("AED")
  targetDate    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]
}

model GoalContribution {
  id          String   @id @default(cuid())
  goalId      String
  amountMinor Int
  date        DateTime @default(now())
  note        String?
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
}
