{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Personal budget workspace settings and preferences for an authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "currency": {
          "type": "string",
          "description": "Preferred ISO 4217 currency code.",
          "enum": ["USD", "EUR", "GBP", "CAD", "AUD", "JPY", "INR", "PKR", "AED"],
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^(USD|EUR|GBP|CAD|AUD|JPY|INR|PKR|AED)$"
        },
        "monthlyBudgetTarget": {
          "type": "number",
          "description": "Overall monthly spending target in the user's selected currency."
        },
        "seededDemoData": {
          "type": "boolean",
          "description": "Whether initial starter categories and sample transactions were seeded."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the workspace was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the workspace was last updated."
        }
      },
      "required": [
        "userId",
        "currency",
        "monthlyBudgetTarget",
        "seededDemoData",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Custom spending or income category with color, icon, and monthly budget limit.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique category identifier matching document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the custom category.",
          "minLength": 1,
          "maxLength": 40
        },
        "kind": {
          "type": "string",
          "description": "Whether the category tracks expenses or income.",
          "enum": ["expense", "income"],
          "minLength": 6,
          "maxLength": 7,
          "pattern": "^(expense|income)$"
        },
        "color": {
          "type": "string",
          "description": "Hex color code used for chart series and category indicators.",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "icon": {
          "type": "string",
          "description": "Icon identifier for the category.",
          "enum": [
            "home",
            "utensils",
            "car",
            "shopping-bag",
            "zap",
            "heart-pulse",
            "film",
            "briefcase",
            "plane",
            "book",
            "gift",
            "layers",
            "wallet",
            "trending-up"
          ],
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z\\-]+$"
        },
        "monthlyLimit": {
          "type": "number",
          "description": "Allocated monthly budget limit for this category (0 if unbudgeted or income)."
        },
        "isArchived": {
          "type": "boolean",
          "description": "Whether the category is archived from active selection."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the category was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the category was last updated."
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "kind",
        "color",
        "icon",
        "monthlyLimit",
        "isArchived",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Individual expense or income entry linked to a user category.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique transaction identifier matching document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoryId": {
          "type": "string",
          "description": "Referenced category document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "description": "Transaction flow direction.",
          "enum": ["expense", "income"],
          "minLength": 6,
          "maxLength": 7,
          "pattern": "^(expense|income)$"
        },
        "amount": {
          "type": "number",
          "description": "Positive monetary value of the transaction."
        },
        "merchant": {
          "type": "string",
          "description": "Merchant, payee, or source description.",
          "minLength": 1,
          "maxLength": 80
        },
        "note": {
          "type": "string",
          "description": "Optional memo or line-item note.",
          "minLength": 0,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "description": "Transaction calendar date in YYYY-MM-DD format.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment channel used for the transaction.",
          "enum": ["card", "bank", "cash", "transfer"],
          "minLength": 4,
          "maxLength": 8,
          "pattern": "^(card|bank|cash|transfer)$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the transaction was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the transaction was last updated."
        }
      },
      "required": [
        "id",
        "userId",
        "categoryId",
        "type",
        "amount",
        "merchant",
        "note",
        "date",
        "paymentMethod",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Per-user budget workspace preferences and global monthly target."
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": {
        "$ref": "#/entities/Category"
      },
      "description": "User-owned custom spending and income categories."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/Transaction"
      },
      "description": "User-owned financial transactions linked to categories."
    }
  }
}
